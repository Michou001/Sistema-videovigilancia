# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en .gitignore porque contiene la contrasena de la camara.

# --- Identidad de la camara ------------------------------------------------
CAMERA_ID=cam-01

# --- Fuente de video -------------------------------------------------------
# Tres formatos posibles. Descomenta el que uses:

# 1) Webcam integrada o USB (para desarrollar HOY, sin la Hikvision)
SOURCE=webcam:0

# 2) Video grabado (pruebas reproducibles: mismo video = mismo resultado)
# SOURCE=file:videos/prueba.mp4

# 3) Hikvision por RTSP. Consigue esta linea corriendo:
#       python tools/probe_camara.py --descubrir
#       python tools/probe_camara.py --host 192.168.1.64 --user admin --password TU_PASS
#    Usa el canal 102 (sub-stream), NO el 101: 640x480 basta para detectar y
#    consume mucha menos GPU en decodificacion.
# SOURCE=rtsp://admin:TU_PASS@192.168.1.64:554/Streaming/Channels/102

# --- Plataforma web --------------------------------------------------------
API_URL=http://127.0.0.1:8000
API_TOKEN=

# --- Computo ---------------------------------------------------------------
DEVICE=auto          # auto | cuda | cpu
INFER_FPS=8          # fps de inferencia (la camara entrega 25-30; no hace falta procesarlos todos)
IMGSZ=640

# --- Detectores activos ----------------------------------------------------
# Se van encendiendo conforme avanzan las fases del plan.
ENABLE_PLATES=true
ENABLE_FACES=false     # Fase 4
ENABLE_WEAPONS=false   # Fase 5

# --- Modelos ---------------------------------------------------------------
PLATE_MODEL=models/plates.pt
WEAPON_MODEL=models/weapons.pt
FACE_MODEL=buffalo_l

# --- Umbrales --------------------------------------------------------------
PLATE_CONF=0.45
OCR_CONF=0.35
WEAPON_CONF=0.60
FACE_CONF=0.50

# --- Confirmacion temporal de armas (anti falso positivo) ------------------
# Un arma solo alerta si aparece en >=4 de los ultimos 6 frames del mismo track.
WEAPON_CONFIRM_HITS=4
WEAPON_CONFIRM_WINDOW=6

# --- Desarrollo ------------------------------------------------------------
SHOW_WINDOW=false    # ventana de OpenCV con las cajas dibujadas
LOG_LEVEL=INFO
