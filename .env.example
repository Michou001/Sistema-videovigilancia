# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en .gitignore porque contiene la contrasena de la camara.
#
# Una segunda camara usa su propio archivo (.env.cam2, .env.cam-02...) con otro
# CAMERA_ID y otro SOURCE. Lo recomendado es correr TODAS en un solo proceso,
# que comparte los modelos en la GPU (caben muchas mas camaras):
#     iniciar_worker.bat --env .env --env .env.cam2 --env .env.cam3
# Tambien se puede un proceso por camara:  iniciar_worker.bat --env .env.cam2

# --- Identidad de la camara ------------------------------------------------
CAMERA_ID=cam-01

# --- Fuente de video -------------------------------------------------------
# Tres formatos posibles. Descomenta el que uses:

# 1) Webcam integrada o USB
SOURCE=webcam:0

# 2) Video grabado (pruebas reproducibles: mismo video = mismo resultado)
# SOURCE=file:videos/prueba.mp4

# 3) Hikvision por RTSP. Consigue esta linea corriendo:
#       python tools/probe_camara.py --descubrir
#       python tools/probe_camara.py --host 192.168.1.64 --user admin --password TU_PASS
#    o desde el dashboard: boton "Camaras".
#    Usa el canal 102 (sub-stream) para detectar: consume mucha menos GPU en
#    decodificacion. La evidencia se toma del 101 (ver SNAPSHOT_HD_*).
# SOURCE=rtsp://admin:TU_PASS@192.168.1.64:554/Streaming/Channels/102

# 4) Pipeline de GStreamer (NVDEC en Jetson/DeepStream; OpenCV con GStreamer):
# SOURCE=gst:rtspsrc location=rtsp://... latency=200 ! rtph264depay ! h264parse ! nvv4l2decoder ! nvvidconv ! video/x-raw,format=BGRx ! videoconvert ! video/x-raw,format=BGR ! appsink drop=1 max-buffers=1

# --- Plataforma web --------------------------------------------------------
API_URL=http://127.0.0.1:8000
# Lo imprime `python tools/init_plataforma.py`.
API_TOKEN=

# --- Computo ---------------------------------------------------------------
DEVICE=auto          # auto | cuda | cpu
INFER_FPS=8          # fps de inferencia (la camara entrega 20-30; no hace falta procesarlos todos)
IMGSZ=640
WEAPON_IMGSZ=960     # solo el detector de armas: un cuchillo es chico y se pierde si se encoge a 640

# --- Aceleracion (mide con: python tools/optimizar_modelos.py) --------------
YOLO_HALF=auto       # FP16 en los YOLO si hay CUDA (Tensor Cores)
ORT_TENSORRT=false   # true: TensorRT para placas y rostros (la 1a vez tarda minutos)
HW_DECODE=off        # auto | d3d11 | vaapi: decodificar el video en la GPU.
                     # Compara el uso de CPU con: python -m edge.worker --diagnostico

# --- Detectores activos ----------------------------------------------------
ENABLE_PLATES=true
ENABLE_FACES=true
# COCO no reconoce bien un arma blanca en la mano de alguien (probado contra
# camara real). Se deja apagado hasta tener un modelo entrenado para eso.
ENABLE_WEAPONS=false
ENABLE_MOTION=true     # velocidad anomala de una persona seguida
# Esqueleto de cada persona (YOLO11-pose, se descarga solo): caida por el
# angulo del torso, manos arriba (asalto) y posible agresion. Una inferencia
# mas por frame (~3-5 ms en GPU).
ENABLE_POSE=true
# Reglas por zona que se dibujan en el dashboard (camara > icono de zonas):
# intrusion con horario, cruce de linea, merodeo y conteo. Usan las personas y
# vehiculos del detector de movimiento (requiere ENABLE_MOTION=true).
ENABLE_ZONAS=true

# --- Modelos ---------------------------------------------------------------
PLATE_DETECTOR=yolo-v9-s-608-license-plate-end2end   # o yolo-v9-t-640-... (mas ligero)
PLATE_OCR=cct-s-v2-global-model                      # o cct-xs-v2-global-model (mas rapido)
WEAPON_MODEL=models/weapons.pt     # si no existe, se usa YOLO11-COCO (solo armas blancas)
FACE_MODEL=buffalo_l
MOTION_MODEL=models/yolo11s.pt     # o el .engine que genera tools/optimizar_modelos.py
POSE_MODEL=models/yolo11n-pose.pt  # yolo11s-pose.pt: mas preciso, el doble de costo

# --- Umbrales --------------------------------------------------------------
PLATE_CONF=0.45
OCR_CONF=0.35
# Un cuchillo es un objeto chico y delgado: el modelo casi nunca esta muy
# seguro aunque si lo este viendo. Se acepta un umbral bajo y la confirmacion
# temporal (WEAPON_CONFIRM_*) filtra el ruido.
WEAPON_CONF=0.40
FACE_CONF=0.50
MOTION_CONF=0.45              # confianza de deteccion de PERSONA, no del movimiento
MOTION_SPEED_THRESHOLD=2.5    # alturas de cuerpo/segundo; caminar normal ronda 0.8-1.2
MOTION_COOLDOWN_S=30          # espera antes de volver a alertar por la misma persona
POSE_CONF=0.45
MANOS_ARRIBA_S=2              # segundos con las dos manos sobre la cabeza para avisar
POSE_AGRESION=true            # golpes/empujones junto a otra persona (estimacion)

# --- Zonas -----------------------------------------------------------------
ZONAS_REFRESCO_S=15           # cada cuanto se preguntan a la API las zonas de la camara
ZONAS_FRAMES_MIN=3            # frames seguidos dentro para contar como intrusion
# Zona horaria del sitio, para los horarios de las reglas ("de 22:00 a 06:00").
# La lee el worker y la API. En Windows requiere `pip install tzdata`.
ZONA_HORARIA=America/Mexico_City

# --- Eventos de la propia camara Hikvision (ISAPI) --------------------------
# auto: si SOURCE es rtsp:// con usuario, se escucha el alertStream de la
# camara: sabotaje (lente tapado, camara movida o desenfocada), perdida de
# video y la analitica propia de la camara (cruce de linea, intrusion). Hay que
# activar esas funciones en la camara (Configuracion > Evento).
ISAPI=auto
ISAPI_PUERTO=80
ISAPI_HTTPS=false
ISAPI_EVENTOS=sabotaje,perdida_video,deteccion_linea,intrusion_camara   # + movimiento_camara (ruidoso)

# --- Rostros ---------------------------------------------------------------
FACE_MIN_WIDTH=50             # px; por debajo el embedding no sirve para identificar
FACE_TEMPLATE_SIZE=3          # mejores vistas que se promedian por persona seguida

# --- Confirmacion temporal de armas (anti falso positivo) ------------------
# Un arma solo alerta si aparece en >=4 de los ultimos 6 frames del mismo track.
WEAPON_CONFIRM_HITS=4
WEAPON_CONFIRM_WINDOW=6

# --- Confirmacion temporal de movimiento anomalo ----------------------------
# Ventana mas corta que la de armas: un forcejeo dura menos de un segundo.
MOTION_CONFIRM_HITS=3
MOTION_CONFIRM_WINDOW=5

# --- Evidencia -------------------------------------------------------------
# Foto del canal principal (101) de la Hikvision para rostros, placas y
# movimiento. Solo aplica si SOURCE es rtsp:// con usuario y contrasena.
SNAPSHOT_HD_ENABLED=true
SNAPSHOT_HD_CHANNEL=101
# auto: adjunta la foto al evento solo si la API corre en otra maquina.
SEND_SNAPSHOT_B64=auto

# --- Clips de video de las alertas ----------------------------------------
# El worker guarda en memoria los ultimos CLIP_PRE_S segundos. Cuando la API
# responde que un evento fue alerta (warning o critical), graba CLIP_POST_S
# segundos mas y sube el clip: el operador ve que paso ANTES y DESPUES.
CLIP_ENABLED=true
CLIP_PRE_S=10
CLIP_POST_S=10
CLIP_ANCHO=960       # ancho del video; menos = clips mas ligeros
CLIP_CALIDAD=80      # calidad JPEG del bufer en memoria, 20-95
# auto: H.264 (MP4) si esta instalado PyAV (pip install av), si no VP8 (WebM),
# que ya trae OpenCV. Ambos se reproducen en cualquier navegador. Ver
# docs/licencias.md sobre H.264.
CLIP_CODEC=auto

# --- Vista en vivo en el dashboard -----------------------------------------
# No cuesta nada mientras nadie tenga el dashboard abierto: la API responde
# cuantos lo estan mirando y el worker deja de codificar y enviar si son cero.
# Ponlo en false si el enlace hasta la API es estrecho o si por politica el
# video no debe salir de la red de las camaras.
PREVIEW_ENABLED=true
PREVIEW_FPS=6        # independiente de INFER_FPS; por encima de 8 no se aprecia
PREVIEW_WIDTH=640    # ancho al que se reduce antes de enviar
PREVIEW_QUALITY=70   # calidad JPEG, 20-95

HEARTBEAT_S=15       # cada cuanto el worker reporta su salud a la API

# --- API (solo la lee `python -m api`) --------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# HTTPS: genera el certificado con `python tools/generar_certificado.py` y
# descomenta estas dos lineas. Por la conexion pasan contrasenas, fotos y video.
# SSL_CERTFILE=data/tls/servidor.crt
# SSL_KEYFILE=data/tls/servidor.key
# Proxys de confianza (Caddy/nginx delante de la API) cuyas cabeceras
# X-Forwarded-* se respetan para saber la IP real y si fue HTTPS.
# FORWARDED_ALLOW_IPS=127.0.0.1
# DATABASE_URL=sqlite:///data/vigilancia.db
# PostgreSQL: recomendado desde 2-3 camaras (SQLite serializa las escrituras).
# pip install "psycopg[binary]". Las tablas las crea la API sola al arrancar.
# DATABASE_URL=postgresql+psycopg://vigilancia:CLAVE@localhost:5432/vigilancia
# Varios procesos de API (muchos dashboards o camaras): Redis comparte alertas,
# video en vivo, limite de login y cache de lista negra. pip install redis
# REDIS_URL=redis://localhost:6379/0
# API_WORKERS=4
# JWT_HOURS=12
# --- Notificaciones fuera del dashboard (API) -----------------------------
# Cada canal se activa al llenar sus datos. Prueba desde el dashboard:
# Administracion > Notificaciones > Enviar prueba.
NOTIFY_MIN_SEVERITY=critical   # critical | warning | info
# Aviso cuando una camara lleva este tiempo sin imagen (y cuando se recupera).
# Tambien genera la alerta en el dashboard. 0 = desactivado.
NOTIFY_CAMARA_CAIDA_S=120
NOTIFY_MAX_POR_MINUTO=20       # tope anti-inundacion
# Enlace al dashboard dentro del aviso, ej. https://vigilancia.miempresa.mx
# NOTIFY_URL_DASHBOARD=
# PRIVACIDAD: la foto de la alerta sale a un servicio externo. Activalo solo si
# el aviso de privacidad lo contempla (docs/privacidad.md).
NOTIFY_INCLUDE_PHOTO=false
# Telegram: crea el bot con @BotFather; el chat id lo da @userinfobot (o el id
# negativo de un grupo donde este el bot).
# NOTIFY_TELEGRAM_TOKEN=123456:ABC...
# NOTIFY_TELEGRAM_CHATS=111111111,-1002222222222
# Correo (SMTP). NOTIFY_SMTP_TLS: starttls (puerto 587) | ssl (465) | none
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=alertas@miempresa.mx
# NOTIFY_SMTP_PASSWORD=contrasena-de-aplicacion
# NOTIFY_SMTP_FROM=alertas@miempresa.mx
# NOTIFY_SMTP_TO=seguridad@miempresa.mx,gerencia@miempresa.mx
# NOTIFY_SMTP_TLS=starttls
# WhatsApp por Twilio (numeros con lada internacional, ej. +5213312345678)
# NOTIFY_TWILIO_SID=AC...
# NOTIFY_TWILIO_TOKEN=
# NOTIFY_TWILIO_FROM=+14155238886
# NOTIFY_TWILIO_TO=+5213312345678
# Webhook: JSON por POST a cualquier servicio (n8n, Make, un bot propio, la
# API de WhatsApp de Meta). Con secreto, cada envio lleva la cabecera
# X-Goss-Firma: sha256=HMAC(secreto, cuerpo) para verificar el origen.
# NOTIFY_WEBHOOK_URL=https://n8n.miempresa.mx/webhook/alertas
# NOTIFY_WEBHOOK_SECRETO=

FACE_MATCH_THRESHOLD=0.50     # similitud coseno minima para coincidencia facial
PLATE_FUZZY_MAX_DIST=1        # errores de OCR tolerados al cruzar placas

# Retencion de datos (dias). Ver docs/privacidad.md.
RETENCION_FOTOS_DIAS=7
RETENCION_EVENTOS_DIAS=30
RETENCION_ALERTAS_DIAS=365
RETENCION_CLIPS_DIAS=90       # video de las alertas; 0 = lo mismo que la alerta
RETENCION_EMBEDDINGS_DIAS=7
RETENCION_AUDITORIA_DIAS=730   # bitacora de quien hizo que; 0 = sin limite
RETENCION_CORREGIDOS_DIAS=180  # placas corregidas por un operador (dataset para el OCR)

# --- Desarrollo ------------------------------------------------------------
SHOW_WINDOW=false    # ventana de OpenCV con las cajas dibujadas
LOG_LEVEL=INFO
