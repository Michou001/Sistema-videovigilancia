# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en .gitignore porque contiene la contrasena de la camara.
#
# Una segunda camara usa su propio archivo (.env.cam2, .env.cam-02...) con otro
# CAMERA_ID y otro SOURCE:  iniciar_worker.bat --env .env.cam2

# --- Identidad de la camara ------------------------------------------------
CAMERA_ID=cam-01

# --- Fuente de video -------------------------------------------------------
# Tres formatos posibles. Descomenta el que uses:

# 1) Webcam integrada o USB
SOURCE=webcam:0

# 2) Video grabado (pruebas reproducibles: mismo video = mismo resultado)
# SOURCE=file:videos/prueba.mp4

# 3) Hikvision por RTSP. Consigue esta linea corriendo:
#       python tools/probe_camara.py --descubrir
#       python tools/probe_camara.py --host 192.168.1.64 --user admin --password TU_PASS
#    o desde el dashboard: boton "Camaras".
#    Usa el canal 102 (sub-stream) para detectar: consume mucha menos GPU en
#    decodificacion. La evidencia se toma del 101 (ver SNAPSHOT_HD_*).
# SOURCE=rtsp://admin:TU_PASS@192.168.1.64:554/Streaming/Channels/102

# --- Plataforma web --------------------------------------------------------
API_URL=http://127.0.0.1:8000
# Lo imprime `python tools/init_plataforma.py`.
API_TOKEN=

# --- Computo ---------------------------------------------------------------
DEVICE=auto          # auto | cuda | cpu
INFER_FPS=8          # fps de inferencia (la camara entrega 20-30; no hace falta procesarlos todos)
IMGSZ=640
WEAPON_IMGSZ=960     # solo el detector de armas: un cuchillo es chico y se pierde si se encoge a 640

# --- Detectores activos ----------------------------------------------------
ENABLE_PLATES=true
ENABLE_FACES=true
# COCO no reconoce bien un arma blanca en la mano de alguien (probado contra
# camara real). Se deja apagado hasta tener un modelo entrenado para eso.
ENABLE_WEAPONS=false
ENABLE_MOTION=true     # velocidad anomala de una persona seguida

# --- Modelos ---------------------------------------------------------------
PLATE_DETECTOR=yolo-v9-s-608-license-plate-end2end   # o yolo-v9-t-640-... (mas ligero)
PLATE_OCR=cct-s-v2-global-model                      # o cct-xs-v2-global-model (mas rapido)
WEAPON_MODEL=models/weapons.pt     # si no existe, se usa YOLO11-COCO (solo armas blancas)
FACE_MODEL=buffalo_l

# --- Umbrales --------------------------------------------------------------
PLATE_CONF=0.45
OCR_CONF=0.35
# Un cuchillo es un objeto chico y delgado: el modelo casi nunca esta muy
# seguro aunque si lo este viendo. Se acepta un umbral bajo y la confirmacion
# temporal (WEAPON_CONFIRM_*) filtra el ruido.
WEAPON_CONF=0.40
FACE_CONF=0.50
MOTION_CONF=0.45              # confianza de deteccion de PERSONA, no del movimiento
MOTION_SPEED_THRESHOLD=2.5    # alturas de cuerpo/segundo; caminar normal ronda 0.8-1.2
MOTION_COOLDOWN_S=30          # espera antes de volver a alertar por la misma persona

# --- Rostros ---------------------------------------------------------------
FACE_MIN_WIDTH=50             # px; por debajo el embedding no sirve para identificar
FACE_TEMPLATE_SIZE=3          # mejores vistas que se promedian por persona seguida

# --- Confirmacion temporal de armas (anti falso positivo) ------------------
# Un arma solo alerta si aparece en >=4 de los ultimos 6 frames del mismo track.
WEAPON_CONFIRM_HITS=4
WEAPON_CONFIRM_WINDOW=6

# --- Confirmacion temporal de movimiento anomalo ----------------------------
# Ventana mas corta que la de armas: un forcejeo dura menos de un segundo.
MOTION_CONFIRM_HITS=3
MOTION_CONFIRM_WINDOW=5

# --- Evidencia -------------------------------------------------------------
# Foto del canal principal (101) de la Hikvision para rostros, placas y
# movimiento. Solo aplica si SOURCE es rtsp:// con usuario y contrasena.
SNAPSHOT_HD_ENABLED=true
SNAPSHOT_HD_CHANNEL=101
# auto: adjunta la foto al evento solo si la API corre en otra maquina.
SEND_SNAPSHOT_B64=auto

# --- Vista en vivo en el dashboard -----------------------------------------
# No cuesta nada mientras nadie tenga el dashboard abierto: la API responde
# cuantos lo estan mirando y el worker deja de codificar y enviar si son cero.
# Ponlo en false si el enlace hasta la API es estrecho o si por politica el
# video no debe salir de la red de las camaras.
PREVIEW_ENABLED=true
PREVIEW_FPS=6        # independiente de INFER_FPS; por encima de 8 no se aprecia
PREVIEW_WIDTH=640    # ancho al que se reduce antes de enviar
PREVIEW_QUALITY=70   # calidad JPEG, 20-95

HEARTBEAT_S=15       # cada cuanto el worker reporta su salud a la API

# --- API (solo la lee `python -m api`) --------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# HTTPS: genera el certificado con `python tools/generar_certificado.py` y
# descomenta estas dos lineas. Por la conexion pasan contrasenas, fotos y video.
# SSL_CERTFILE=data/tls/servidor.crt
# SSL_KEYFILE=data/tls/servidor.key
# Proxys de confianza (Caddy/nginx delante de la API) cuyas cabeceras
# X-Forwarded-* se respetan para saber la IP real y si fue HTTPS.
# FORWARDED_ALLOW_IPS=127.0.0.1
# DATABASE_URL=sqlite:///data/vigilancia.db
# DATABASE_URL=postgresql+psycopg://vigilancia:CLAVE@localhost:5432/vigilancia
# JWT_HOURS=12
FACE_MATCH_THRESHOLD=0.50     # similitud coseno minima para coincidencia facial
PLATE_FUZZY_MAX_DIST=1        # errores de OCR tolerados al cruzar placas

# Retencion de datos (dias). Ver docs/privacidad.md.
RETENCION_FOTOS_DIAS=7
RETENCION_EVENTOS_DIAS=30
RETENCION_ALERTAS_DIAS=365
RETENCION_EMBEDDINGS_DIAS=7
RETENCION_AUDITORIA_DIAS=730   # bitacora de quien hizo que; 0 = sin limite

# --- Desarrollo ------------------------------------------------------------
SHOW_WINDOW=false    # ventana de OpenCV con las cajas dibujadas
LOG_LEVEL=INFO
