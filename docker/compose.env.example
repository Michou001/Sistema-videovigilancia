# Variables de docker-compose.yml. Copia a docker/compose.env y llenalo:
#     docker compose --env-file docker/compose.env up -d --build
# docker/compose.env esta fuera de git: lleva secretos.

# Lo que se escribe en el navegador: un dominio (HTTPS automatico con Let's
# Encrypt) o la IP de esta PC en la red local (HTTPS con la CA interna de Caddy).
SITIO=192.168.1.10

# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
API_TOKEN=
JWT_SECRET=

API_WORKERS=2
ZONA_HORARIA=America/Mexico_City
